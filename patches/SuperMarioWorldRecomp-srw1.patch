+    # whose only path is the launcher's Generate & rebuild wizard.
+    smw_add_recomp_target(SuperRyuWorld1SNESRecomp "")
+    snesrecomp_target_generated_code(SuperRyuWorld1SNESRecomp "${SMW_SRW1_GEN_DIR}")
+    target_sources(SuperRyuWorld1SNESRecomp PRIVATE src/srw1_hle.c src/srw1_options.c src/srw1_interp.c
+        ${SNESRECOMP_ROOT}/host/snesrecomp_codegen_host.c)
+    target_include_directories(SuperRyuWorld1SNESRecomp PRIVATE
+        ${SNESRECOMP_ROOT}/host ${RECOMP_UI_ROOT}/src)
+    if(SNESRECOMP_SETUP_HOST)
+        # Never-called link placeholders for generated symbols the hand-written
+        # host references (SnesInit refuses to boot a guest in a setup host).
+        # No funcs.h ships in the pack: derive the declarations from the
+        # bank cfgs (no ROM involved) for the setup build only.
+        set(_srw1_setup_inc "${CMAKE_CURRENT_BINARY_DIR}/srw1_setup_include")
+        file(MAKE_DIRECTORY "${_srw1_setup_inc}")
+        execute_process(COMMAND ${Python3_EXECUTABLE}
+            ${CMAKE_SOURCE_DIR}/tools/srw1_generate.py funcs-h ${_srw1_setup_inc}/funcs.h
+            RESULT_VARIABLE _srw1_fh_rc)
+        if(NOT _srw1_fh_rc EQUAL 0)
+            message(FATAL_ERROR "tools/srw1_generate.py funcs-h failed")
+        endif()
+        target_include_directories(SuperRyuWorld1SNESRecomp BEFORE PRIVATE ${_srw1_setup_inc})
+        set(_srw1_setup_stubs "${CMAKE_CURRENT_BINARY_DIR}/srw1_setup_host_stubs.c")
+        execute_process(COMMAND ${Python3_EXECUTABLE}
+            ${CMAKE_SOURCE_DIR}/tools/srw1_setup_stubs.py
+            --funcs-h ${_srw1_setup_inc}/funcs.h
+            --src-root ${CMAKE_SOURCE_DIR}/src --out ${_srw1_setup_stubs}
+            RESULT_VARIABLE _srw1_stub_rc)
+        if(NOT _srw1_stub_rc EQUAL 0)
+            message(FATAL_ERROR "tools/srw1_setup_stubs.py failed")
+        endif()
+        target_sources(SuperRyuWorld1SNESRecomp PRIVATE ${_srw1_setup_stubs})
+    elseif(SMW_SRW1_PACK AND IS_DIRECTORY "${CMAKE_SOURCE_DIR}/shaders")
+        # One-click pack: the game is rebuilt into build/; give it the
+        # shaders/ folder that ships at the pack root.
+        add_custom_command(TARGET SuperRyuWorld1SNESRecomp POST_BUILD
+            COMMAND ${CMAKE_COMMAND} -E copy_directory
+                "${CMAKE_SOURCE_DIR}/shaders"
+                "$<TARGET_FILE_DIR:SuperRyuWorld1SNESRecomp>/shaders"
+            VERBATIM)
+    endif()
+    if(WIN32 AND NOT SNESRECOMP_SETUP_HOST)
+        # Playable Windows build: no console window (logs go to
+        # SuperRyuWorld1.log beside the exe, or a console with --console).
+        set_target_properties(SuperRyuWorld1SNESRecomp PROPERTIES WIN32_EXECUTABLE TRUE)
+    endif()
+    target_include_directories(SuperRyuWorld1SNESRecomp BEFORE PRIVATE
+        ${CMAKE_SOURCE_DIR}/recomp/srw1)
+    # Native AOT on by default for SRW1: replace the stock interpreted-floor
+    # default set by smw_add_recomp_target (interpreter only for force_lle /
+    # uncompiled targets; SNESRECOMP_LLE_BOUNCE=0 forces the all-interpreter path).
+    get_target_property(_srw1_defs SuperRyuWorld1SNESRecomp COMPILE_DEFINITIONS)
+    list(REMOVE_ITEM _srw1_defs SNESRECOMP_LLE_BOUNCE_DEFAULT=0)
+    list(APPEND _srw1_defs SNESRECOMP_LLE_BOUNCE_DEFAULT=1)
+    set_property(TARGET SuperRyuWorld1SNESRecomp PROPERTY COMPILE_DEFINITIONS "${_srw1_defs}")
+    target_compile_definitions(SuperRyuWorld1SNESRecomp PRIVATE
+        SMW_SRW1_BUILD=1
+        SNES_GAME_VERSION="srw1-recomp-1"
+    )
+endif()
