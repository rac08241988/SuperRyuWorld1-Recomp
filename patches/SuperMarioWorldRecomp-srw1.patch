+static unsigned SideCompile(GLenum type, const char *src) {
+  unsigned sh = glCreateShader(type);
+  glShaderSource(sh, 1, &src, NULL);
+  glCompileShader(sh);
+  int ok = 0;
+  glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    char log[512];
+    glGetShaderInfoLog(sh, sizeof(log), NULL, log);
+    fprintf(stderr, "[srw1] side-art shader: %s\n", log);
+  }
+  return sh;
+}
+
+static bool SideInit(void) {
+  if (g_side_prog) return true;
+  if (g_side_init_failed) return false;
+  const char *vs = "#version 330 core\n" CODE(
+    layout(location = 0) in vec2 aPos;
+    layout(location = 1) in vec2 aUv;
+    out vec2 uv;
+    void main(void) { gl_Position = vec4(aPos, 0.0, 1.0); uv = aUv; }
+  );
+  const char *fs = "#version 330 core\n" CODE(
+    in vec2 uv;
+    out vec4 FragColor;
+    uniform sampler2D tex;
+    uniform vec2 texel;
+    uniform float inner;
+    void main(void) {
+      vec3 c = texture(tex, uv).rgb * 0.2;
+      c += texture(tex, uv + vec2(texel.x * 1.5, 0.0)).rgb * 0.1;
+      c += texture(tex, uv - vec2(texel.x * 1.5, 0.0)).rgb * 0.1;
+      c += texture(tex, uv + vec2(0.0, texel.y * 1.5)).rgb * 0.1;
+      c += texture(tex, uv - vec2(0.0, texel.y * 1.5)).rgb * 0.1;
+      c += texture(tex, uv + texel * 1.5).rgb * 0.1;
+      c += texture(tex, uv - texel * 1.5).rgb * 0.1;
+      c += texture(tex, uv + vec2(texel.x, -texel.y) * 1.5).rgb * 0.1;
+      c += texture(tex, uv - vec2(texel.x, -texel.y) * 1.5).rgb * 0.1;
+      float d = abs(uv.x - 0.5) * 2.0;
+      float k = 0.62 - 0.30 * smoothstep(inner, 1.0, d);
+      FragColor = vec4(c * k, 1.0);
+    }
+  );
+  unsigned v = SideCompile(GL_VERTEX_SHADER, vs), f = SideCompile(GL_FRAGMENT_SHADER, fs);
+  unsigned prog = glCreateProgram();
+  glAttachShader(prog, v);
+  glAttachShader(prog, f);
+  glLinkProgram(prog);
+  int ok = 0;
+  glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    g_side_init_failed = true;
+    fprintf(stderr, "[srw1] side-art program failed to link; bars stay black\n");
+    return false;
+  }
+  g_side_buf = (uint8 *)calloc((size_t)kSideW * kSideH, 4);
+  glGenTextures(1, &g_side_tex);
+  glBindTexture(GL_TEXTURE_2D, g_side_tex);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, kSideW, kSideH, 0, GL_BGRA,
+               GL_UNSIGNED_INT_8_8_8_8_REV, g_side_buf);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glGenVertexArrays(1, &g_side_vao);
+  glGenBuffers(1, &g_side_vbo);
+  glBindVertexArray(g_side_vao);
+  glBindBuffer(GL_ARRAY_BUFFER, g_side_vbo);
+  glBufferData(GL_ARRAY_BUFFER, sizeof(float) * 4 * 12, NULL, GL_DYNAMIC_DRAW);
+  glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void *)0);
+  glEnableVertexAttribArray(0);
+  glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void *)(2 * sizeof(float)));
+  glEnableVertexAttribArray(1);
+  g_side_prog = prog;
+  return true;
+}
+
+static void SideQuad(float *v, float x0, float x1, float y0, float y1,
+                     float u0, float u1) {
+  const float q[6][4] = {
+    {x0, y0, u0, 1.0f}, {x1, y0, u1, 1.0f}, {x0, y1, u0, 0.0f},
+    {x1, y0, u1, 1.0f}, {x1, y1, u1, 0.0f}, {x0, y1, u0, 0.0f},
+  };
+  memcpy(v, q, sizeof(q));
+}
+
+static void Srw1DrawSideArt(int dw, int dh, int vx, int vy, int vw, int vh) {
+  if (!Srw1Options_SideArt()) { g_side_valid = false; g_side_serial = 0; return; }
+  if (vx <= 0 || vw <= 0 || dw <= 0 || dh <= 0) return;
+  if (!SideInit()) return;
+  if (Srw1Interp_RenderSideArt(g_side_buf, kSideExtra, &g_side_serial)) {
+    glBindTexture(GL_TEXTURE_2D, g_side_tex);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, kSideW, kSideH, GL_BGRA,
+                    GL_UNSIGNED_INT_8_8_8_8_REV, g_side_buf);
+    g_side_valid = true;
+    const char *dump = getenv("SRW1_SIDE_DUMP"); /* test hook: raw PPM */
+    static bool dumped;
+    if (dump && !dumped && g_gl_present_count >= 400 && (dumped = true)) {
+      FILE *f = fopen(dump, "wb");
+      if (f) {
+        fprintf(f, "P6\n%d %d\n255\n", kSideW, kSideH);
+        for (int i = 0; i < kSideW * kSideH; i++) {
+          uint8 rgb[3] = {g_side_buf[i * 4 + 2], g_side_buf[i * 4 + 1], g_side_buf[i * 4]};
+          fwrite(rgb, 1, 3, f);
+        }
+        fclose(f);
+      }
+    }
+  }
+  if (!g_side_valid) return;
+  float sx = (float)vw / 256.0f;                 /* screen px per SNES px */
+  float bar = (float)kSideExtra * sx;
+  float lx0 = (float)vx - bar, lx1 = (float)vx;
+  float rx0 = (float)(vx + vw), rx1 = (float)(vx + vw) + bar;
+  float nx = 2.0f / (float)dw, ny = 2.0f / (float)dh;
+  float y0 = (float)vy * ny - 1.0f, y1 = (float)(vy + vh) * ny - 1.0f;
+  float ue = (float)kSideExtra / (float)kSideW;
+  float v[48];
+  SideQuad(v, lx0 * nx - 1.0f, lx1 * nx - 1.0f, y0, y1, 0.0f, ue);
+  SideQuad(v + 24, rx0 * nx - 1.0f, rx1 * nx - 1.0f, y0, y1, 1.0f - ue, 1.0f);
+  glViewport(0, 0, dw, dh);
+  glUseProgram(g_side_prog);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, g_side_tex);
+  glUniform1i(glGetUniformLocation(g_side_prog, "tex"), 0);
+  glUniform2f(glGetUniformLocation(g_side_prog, "texel"), 1.0f / kSideW, 1.0f / kSideH);
+  glUniform1f(glGetUniformLocation(g_side_prog, "inner"), 256.0f / (float)kSideW);
+  glBindVertexArray(g_side_vao);
+  glBindBuffer(GL_ARRAY_BUFFER, g_side_vbo);
+  glBufferSubData(GL_ARRAY_BUFFER, 0, sizeof(v), v);
+  glDrawArrays(GL_TRIANGLES, 0, 12);
+  glBindTexture(GL_TEXTURE_2D, g_texture.gl_texture);
+  /* GLSL presets set attribute state on whatever VAO is bound; hand the
+   * renderer's own VAO back so they never clobber the side-art VAO. */
+  glBindVertexArray(g_VAO);
+}
+
+/* Test hook: SRW1_GL_SHOT=<file.ppm> SRW1_GL_SHOT_FRAME=<n> writes the final
+ * (post-shader) back buffer of the n-th presented frame. */
+static void Srw1MaybeGlShot(int w, int h) {
+  const char *path = getenv("SRW1_GL_SHOT");
+  const char *fr = getenv("SRW1_GL_SHOT_FRAME");
+  const char *cnt = getenv("SRW1_GL_SHOT_COUNT");
+  if (!path || !fr) return;
+  unsigned first = (unsigned)atoi(fr), n = cnt ? (unsigned)atoi(cnt) : 1;
+  if (g_gl_present_count < first || g_gl_present_count >= first + n) return;
+  char numbered[1024];
+  if (cnt) {
+    snprintf(numbered, sizeof(numbered), "%s.%05u.ppm", path, g_gl_present_count);
+    path = numbered;
+  }
+  unsigned char *px = (unsigned char *)malloc((size_t)w * h * 3);
+  if (!px) return;
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, px);
+  FILE *f = fopen(path, "wb");
+  if (f) {
+    fprintf(f, "P6\n%d %d\n255\n", w, h);
+    for (int y = h - 1; y >= 0; y--) fwrite(px + (size_t)y * w * 3, 1, (size_t)w * 3, f);
+    fclose(f);
+  }
+  free(px);
+}
