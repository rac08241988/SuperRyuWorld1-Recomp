+
+static void Srw1WaitUntil(uint64 target) {
+  uint64 freq = SDL_GetPerformanceFrequency();
+  for (;;) {
+    uint64 now = SDL_GetPerformanceCounter();
+    if (now >= target) return;
+    uint64 ms = (target - now) * 1000 / freq;
+    if (ms > 1) SDL_Delay((uint32)(ms - 1));
+  }
+}
+
+static void Srw1DrawInterpolated(void) {
+  uint64 t0 = SDL_GetPerformanceCounter();
+  double period = (double)SDL_GetPerformanceFrequency() / 60.0;
+  /* The live raster also runs HDMA + the raster IRQ: exactly once per tick. */
+  RtlDrawPpuFrame(g_srw1_live_pixels, 1024, g_ppu_render_flags);
+  const uint32 dump_frame = snes_frame_counter ? snes_frame_counter - 1 : 0;
+  FrameDump_Present(dump_frame, g_srw1_live_pixels, 1024, 256, 224);
+  FrameDump_Ppu(dump_frame, g_ppu);
+  int n = Srw1DisplaySubframes();
+  bool extrapolate = Srw1Interp_GetMode() == kSrw1Motion_Extrapolate;
+  for (int k = 0; k < n; k++) {
+    if (k > 0) Srw1WaitUntil(t0 + (uint64)(period * k / n));
+    /* Interpolate: k/n of the way from the previous tick, ending exactly on
+     * the newest tick (<= 1 tick of delay). Low-latency: newest tick first,
+     * then projected forward. */
+    float f = extrapolate ? (float)k / n : (float)(k + 1) / n - 1.0f;
+    if (f != 0.0f && Srw1Interp_RenderSubframe(f, g_srw1_sub_pixels))
+      Srw1PresentPixels(g_srw1_sub_pixels);
+    else
+      Srw1PresentPixels(g_srw1_live_pixels);
+  }
+}
