+# Super Ryu World 1 (Lunar Magic/AddmusicK ROM hack). Local-only experimental
+# target: generated from the user's patched ROM by tools/regen_srw1.sh.
+option(SMW_BUILD_SRW1 "Build the Super Ryu World 1 executable" OFF)
+if(SMW_BUILD_SRW1)
+    if(SMW_SRW1_PACK)
+        # The stock SMW mod catalog (MSU-1, widescreen, co-op, Falcon) targets
+        # stock SMW, not SRW1; the pack does not stage it.
+        set_property(GLOBAL APPEND PROPERTY SNESRECOMP_MOD_CATALOG_TARGETS SuperRyuWorld1SNESRecomp)
+    endif()
+    set(SMW_SRW1_GEN_DIR "${CMAKE_SOURCE_DIR}/src/gen-srw1" CACHE PATH
