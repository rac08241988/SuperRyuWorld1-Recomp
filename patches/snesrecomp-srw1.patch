+  /* Opt-in full state dump (WRAM/ARAM/DSP/...) at listed frames, e.g.
+   * SNESRECOMP_STATE_DUMP_FRAMES=120,300,600 -> <framedump>/f120.*.bin */
+  if (g_framedump_dir[0]) {
+    const char *sl = getenv("SNESRECOMP_STATE_DUMP_FRAMES");
+    if (sl && *sl) {
+      char buf[256]; snprintf(buf, sizeof(buf), ",%s,", sl);
+      char key[24]; snprintf(key, sizeof(key), ",%u,", frame);
+      if (strstr(buf, key)) {
+        char tag[24]; snprintf(tag, sizeof(tag), "f%u", frame);
+        snes_state_dump(g_framedump_dir, tag, NULL, 0, 0, 0, frame);
+      }
+    }
+  }
   if (!g_framedump_pixels || !ppu || frame < g_framedump_start ||
       frame > g_framedump_end) return;
   char path[768];
