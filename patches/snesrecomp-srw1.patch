+/* SNESRECOMP_NATIVE_STATS=1: at exit, report how much guest CPU time ran on
+ * the interpreter tier (executed opcodes vs. idle-loop replay/skip) versus the
+ * rest (compiled AOT bodies + DMA/other charges). Diagnostic only. */
+static uint64_t g_ns_interp_exec_master = 0, g_ns_interp_idle_master = 0;
+static const CpuState *g_ns_cpu = NULL;
+static uint64_t g_ns_exit_total = 0;
+static void ns_report(void) {
+    const CpuState *c = g_ns_cpu;
+    uint64_t tot = g_ns_exit_total ? g_ns_exit_total : (c ? c->master_cycles : 0);
+    if (!tot) return;
+    uint64_t other = tot - g_ns_interp_exec_master - g_ns_interp_idle_master;
+    uint64_t busy = tot - g_ns_interp_idle_master;
+    fprintf(stderr, "[native-stats] guest master cycles: total=%llu interp_exec=%llu interp_idle=%llu native+other=%llu | native share of non-idle CPU time = %.2f%%\n",
+            (unsigned long long)tot, (unsigned long long)g_ns_interp_exec_master,
+            (unsigned long long)g_ns_interp_idle_master, (unsigned long long)other,
+            busy ? 100.0 * (double)other / (double)busy : 0.0);
+}
+__attribute__((constructor)) static void ns_init(void) {
+    const char *e = getenv("SNESRECOMP_NATIVE_STATS");
+    if (e && e[0] && e[0] != '0') atexit(ns_report);
+}
